# Server configuration
PORT=3000
NODE_ENV=production

# Security - Change this to your frontend domain in production (e.g. https://mydomain.com)
CORS_ORIGIN=*

# Database storage path
# IMPORTANT: When deploying to cloud platforms (Render, Railway, Docker), ensure this 
# points to a persistent volume path, otherwise SQLite data will be lost on restart!
DATABASE_PATH=./data/database.sqlite

# System limits
MAX_CONCURRENT_JOBS=2
MAX_LEAD_LIMIT=5000

# Scraper configuration
BROWSER_HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
